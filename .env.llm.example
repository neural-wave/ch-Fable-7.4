# Open-weights model for Claude Code (scripts/claude-open.sh) and for step 5 of the lab (lab suggest).
# Copy this file to .env.llm (not versioned) and replace the REPLACE_ME values.
# Claude Code needs an endpoint that speaks the Anthropic Messages API. Anthropic does not support non-Claude
# models behind Claude Code: it works, at our own risk, and a Claude Code update can break it.

# Profile B (default): hosted endpoint compatible with the Anthropic Messages API, e.g. Ollama Cloud
# (key: https://ollama.com/settings/keys, model list: curl https://ollama.com/api/tags) or the hackathon endpoint.
ANTHROPIC_BASE_URL=https://ollama.com
ANTHROPIC_AUTH_TOKEN=REPLACE_ME
OPEN_MODEL=REPLACE_ME
OPEN_CONTEXT=131072

# Step 5 (lab suggest) uses the same endpoint, key and model unless these are set:
# LLM_PROTOCOL=openai
# LLM_BASE_URL=https://REPLACE_ME/v1
# LLM_API_KEY=REPLACE_ME
# LLM_MODEL=REPLACE_ME

# Profile A: local Ollama. Start the server with: OLLAMA_CONTEXT_LENGTH=65536 ollama serve
# ANTHROPIC_BASE_URL=http://localhost:11434
# ANTHROPIC_AUTH_TOKEN=ollama
# OPEN_MODEL=gpt-oss:20b
# OPEN_CONTEXT=65536

# Profile C: endpoint with the OpenAI API only, behind LiteLLM: litellm --config lab/litellm.yaml --port 4000
# ANTHROPIC_BASE_URL=http://localhost:4000
# ANTHROPIC_AUTH_TOKEN=REPLACE_ME
# OPEN_MODEL=open-model
# OPEN_CONTEXT=REPLACE_ME
# OPEN_LLM_API_KEY=REPLACE_ME
